<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VladislavTsurikov.ConsoleKit.Avalonia.ViewModels"
             x:Class="VladislavTsurikov.ConsoleKit.Abberia.ConsoleDetailView"
             x:DataType="vm:ConsoleViewModel">
  <Border Padding="8" BorderThickness="1"
          BorderBrush="{DynamicResource TkBorderSubtleBrush}"
          Background="{DynamicResource TkSurfaceAltBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <TextBlock Text="{Binding SelectedDetail}"
                 FontFamily="{DynamicResource TkCodeFontFamily}"
                 FontSize="12" TextWrapping="NoWrap" />
    </ScrollViewer>
  </Border>
</UserControl>

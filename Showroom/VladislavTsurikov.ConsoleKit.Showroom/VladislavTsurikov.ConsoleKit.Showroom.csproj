<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AbberiaUIRoot Condition="'$(AbberiaUIRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\AbberiaUI</AbberiaUIRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <ProjectReference Include="..\..\DesktopUI\VladislavTsurikov.ConsoleKit.Abberia\VladislavTsurikov.ConsoleKit.Abberia.csproj" />
    <ProjectReference Include="$(AbberiaUIRoot)\showroom\VladislavTsurikov.Abberia.Showroom.Engine\VladislavTsurikov.Abberia.Showroom.Engine.csproj" />
    <ProjectReference Include="$(AbberiaUIRoot)\showroom\VladislavTsurikov.Abberia.Showroom.Catalog\VladislavTsurikov.Abberia.Showroom.Catalog.csproj" />
    <ProjectReference Include="$(AbberiaUIRoot)\projects\VladislavTsurikov.Abberia.DefaultSkin\VladislavTsurikov.Abberia.DefaultSkin.csproj" />
  </ItemGroup>
</Project>
